<% layout("/layouts/boilerplate") %>
<h2 class="mb-3 offset-3" >Login</h2>
    <form method="POST" action="/login" novalidate class="needs-validation" >
        <div class="mb-3 offset-3">
            <label for="username" class="form-label">UserName</label>
            <input
                name="username"
                placeholder="Enter username"
                type="text"
                class="form-control"
                required
            />
            <div class="invalid-feedback">userName is empty</div>
        </div>

        <div class="mb-3 offset-3">
            <label for="password" class="form-label">Password</label>
            <input
                name="password"
                placeholder="Enter password"
                type="password"
                class="form-control"
                required
            />
            <div class="invalid-feedback">Password is empty</div>
        </div>

        <button type="submit" class="btn btn-dark add-btn offset-3">Login</button>
    </form>
    <br>
    <br>