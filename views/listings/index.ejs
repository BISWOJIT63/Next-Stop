<% layout("/layouts/boilerplate") %>
  <br>

  <body>
    <div id="filters">
      <div class="filter">
        <div class="filter-item">
          <i class="fa-solid fa-fire"></i>
          <p>Tanding</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-city"></i>
          <p>Homes</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-cable-car"></i>
          <p>Fun</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-snowman"></i>
          <p>Winter</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-plane-up"></i>
          <p>Airport</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-water-ladder"></i>
          <p>Pool</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-bed-pulse"></i>
          <p>Rooms</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-bell-concierge"></i>
          <p>Services</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-tent"></i>
          <p>Camping</p>
        </div>
        <div class="filter-item">
          <i class="fa-solid fa-tree"></i>
          <p>Forest</p>
        </div>
        <div class="filter-item">
          <i class="fa-brands fa-web-awesome"></i>
          <p>Premium</p>
        </div>

        <div class="taxTogler">
          <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display price after taxes</label>
          </div>
        </div>
      </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
      <% for(let listing of allListings) { %>
        <a href="/listings/<%=listing.id%>" class="index-links">
          <div class="card posts col">
            <img src="<%=listing.image.url%>" class="card-img-top " alt="listing_image" style="height: 20rem;">
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%= listing.title %>
                </b> <br>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> / nights
                  <span class="tax">+18% GST</span>
              </p>
            </div>
          </div>
        </a>

        <% } %>
    </div>
  </body>
  <script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");

    taxSwitch.addEventListener("click", () => {
      let taxes = document.querySelectorAll(".tax");
      taxes.forEach(tax => {
        if (tax.style.display !== "inline") {
          tax.style.display = "inline";
        } else {
          tax.style.display = "none";
        }
      });
    });
  </script>